# ==============================================================================
# ResearchPilot Configuration
# ==============================================================================
APP_NAME=ResearchPilot
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# ==============================================================================
# Provider Mode Configuration
# - auto: Automatically uses live Gemini & Tavily if keys are set; otherwise runs in Mock mode.
# - mock: Strictly forces offline simulation mode using deterministic mock models.
# - live: Strictly requires valid GEMINI_API_KEY and TAVILY_API_KEY. Fails if keys are missing.
# ==============================================================================
PROVIDER_MODE=auto

# ==============================================================================
# AI Provider Keys
# 1. Gemini API Key:
#    - Obtain free or paid key at Google AI Studio: https://aistudio.google.com/app/apikey
#    - Powers Planner, Fact Checker, Report Writer, and 768-dim Embeddings.
# 2. Tavily Search API Key:
#    - Obtain free key at Tavily AI: https://app.tavily.com/
#    - Powers live external web research agent.
# ==============================================================================
GEMINI_API_KEY=
TAVILY_API_KEY=

# Provider Models
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# ==============================================================================
# Database Configuration (PostgreSQL 16 with pgvector)
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://postgres@172.27.2.138:5433/researchpilot
SYNC_DATABASE_URL=postgresql+psycopg2://postgres@172.27.2.138:5433/researchpilot

# ==============================================================================
# Document RAG Ingestion Settings
# ==============================================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=backend/uploads
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.35
