# ==============================================================================
# ResearchPilot Configuration
# ==============================================================================
APP_NAME=ResearchPilot
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ==============================================================================
# Provider Mode Configuration
# - auto: Automatically uses live Gemini & Tavily if keys are set; otherwise runs in Mock mode.
# - mock: Strictly forces offline simulation mode using deterministic mock models.
# - live: Strictly requires valid GEMINI_API_KEY and TAVILY_API_KEY. Fails if keys are missing.
# ==============================================================================
PROVIDER_MODE=auto

# ==============================================================================
# AI Provider Keys
# 1. Gemini API Key:
#    - Obtain free or paid key at Google AI Studio: https://aistudio.google.com/app/apikey
#    - Powers Planner, Fact Checker, Report Writer, and 768-dim Embeddings.
# 2. Tavily Search API Key:
#    - Obtain free key at Tavily AI: https://app.tavily.com/
#    - Powers live external web research agent.
# ==============================================================================
GEMINI_API_KEY=
TAVILY_API_KEY=

# Provider Models
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# ==============================================================================
# Database & Distributed Cache Configuration
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5433/researchpilot
SYNC_DATABASE_URL=postgresql+psycopg2://postgres@localhost:5433/researchpilot
REDIS_URL=redis://localhost:6379/0

# Maximum Request Body Size in Megabytes (Hard cutoff in middleware)
MAX_REQUEST_BODY_SIZE_MB=30

# ==============================================================================
# Authentication & Security
# ==============================================================================
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
INITIAL_ADMIN_EMAIL=admin@researchpilot.local
INITIAL_ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# ==============================================================================
# Document RAG Ingestion Settings
# ==============================================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=backend/uploads
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.35

# ==============================================================================
# Rate Limiting & Quotas (Configurable per-tier defaults)
# ==============================================================================
RATE_LIMIT_FREE_HOURLY=5
RATE_LIMIT_FREE_DAILY=5
RATE_LIMIT_FREE_MONTHLY=100
RATE_LIMIT_FREE_CONCURRENT=1
RATE_LIMIT_FREE_TAVILY_PER_JOB=5

# ==============================================================================
# Emergency Spending Kill-Switch
# Set to false to immediately block any remote billable API operations
# ==============================================================================
BILLABLE_OPERATIONS_ENABLED=true

# ==============================================================================
# Global Monetary Spending Ceilings & Stripe Monetization (Stage 6)
# ==============================================================================
GLOBAL_DAILY_BUDGET_USD=50.0
GLOBAL_MONTHLY_BUDGET_USD=500.0
DEFAULT_JOB_RESERVATION_USD=0.05
FREE_TIER_COMPLIMENTARY_BALANCE_USD=1.00
PRO_TIER_MONTHLY_BUDGET_USD=25.00

# Stripe Configuration (Optional for live payments; defaults to auto / mock simulation)
STRIPE_MODE=auto
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=


