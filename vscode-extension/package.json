{
  "name": "researchpilot-vscode",
  "displayName": "AI Research Assistant",
  "description": "Institutional-Grade Multi-Agent AI Research & Fact-Checking Assistant for VS Code",
  "version": "0.1.3",
  "icon": "media/icon.png",
  "publisher": "ResearchPilot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mahesh131005/ResearchPilot.git"
  },
  "bugs": {
    "url": "https://github.com/Mahesh131005/ResearchPilot/issues"
  },
  "homepage": "https://researchpilot-web.onrender.com",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "research",
    "multi-agent",
    "fact-checker",
    "rag",
    "langgraph",
    "ai"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onView:researchpilot.sidebar",
    "onCommand:researchpilot.startResearch",
    "onCommand:researchpilot.researchSelection",
    "onCommand:researchpilot.login",
    "onCommand:researchpilot.logout",
    "onCommand:researchpilot.viewUsage",
    "onCommand:researchpilot.refreshHistory",
    "onCommand:researchpilot.saveReportMarkdown",
    "onCommand:researchpilot.uploadDocument"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "researchpilot-activitybar",
          "title": "ResearchPilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "researchpilot-activitybar": [
        {
          "type": "webview",
          "id": "researchpilot.sidebar",
          "name": "ResearchPilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "researchpilot.startResearch",
        "title": "ResearchPilot: Start New Research",
        "category": "ResearchPilot"
      },
      {
        "command": "researchpilot.researchSelection",
        "title": "ResearchPilot: Research Selected Text",
        "category": "ResearchPilot"
      },
      {
        "command": "researchpilot.saveReportMarkdown",
        "title": "ResearchPilot: Save Active Report as Markdown",
        "category": "ResearchPilot"
      },
      {
        "command": "researchpilot.login",
        "title": "ResearchPilot: Log In to Platform",
        "category": "ResearchPilot"
      },
      {
        "command": "researchpilot.logout",
        "title": "ResearchPilot: Log Out",
        "category": "ResearchPilot"
      },
      {
        "command": "researchpilot.viewUsage",
        "title": "ResearchPilot: View Quotas & Usage",
        "category": "ResearchPilot"
      },
      {
        "command": "researchpilot.refreshHistory",
        "title": "ResearchPilot: Refresh Research History",
        "category": "ResearchPilot"
      },
      {
        "command": "researchpilot.uploadDocument",
        "title": "ResearchPilot: Upload Document (PDF) for RAG",
        "category": "ResearchPilot"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "researchpilot.researchSelection",
          "when": "editorHasSelection",
          "group": "ResearchPilot@1"
        }
      ],
      "view/title": [
        {
          "command": "researchpilot.refreshHistory",
          "when": "view == researchpilot.sidebar",
          "group": "navigation"
        },
        {
          "command": "researchpilot.viewUsage",
          "when": "view == researchpilot.sidebar",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "ResearchPilot",
      "properties": {
        "researchpilot.backendUrl": {
          "type": "string",
          "default": "https://researchpilot-api-cb0c.onrender.com",
          "description": "Render backend URL for ResearchPilot API"
        },
        "researchpilot.defaultDepth": {
          "type": "string",
          "enum": [
            "quick",
            "standard",
            "deep"
          ],
          "default": "standard",
          "description": "Default research depth for newly created jobs"
        },
        "researchpilot.enableWeb": {
          "type": "boolean",
          "default": true,
          "description": "Enable external web research (Tavily)"
        },
        "researchpilot.enableDocuments": {
          "type": "boolean",
          "default": true,
          "description": "Enable internal document RAG retrieval (pgvector)"
        },
        "researchpilot.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Optional: Personal Google Gemini API Key (BYOK). Leave blank to use server keys."
        },
        "researchpilot.cohereApiKey": {
          "type": "string",
          "default": "",
          "description": "Optional: Personal Cohere API Key (BYOK). Leave blank to use server keys."
        },
        "researchpilot.tavilyApiKey": {
          "type": "string",
          "default": "",
          "description": "Optional: Personal Tavily API Key (BYOK). Leave blank to use server keys."
        },
        "researchpilot.preferredLlm": {
          "type": "string",
          "enum": [
            "auto",
            "gemini",
            "cohere"
          ],
          "default": "auto",
          "description": "Preferred LLM provider (auto uses multi-provider pool with automatic fallback)"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {}
}
